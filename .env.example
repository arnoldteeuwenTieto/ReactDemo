# Public display label; independent of Vite mode and authorization.
VITE_APP_ENV=DEV
# Omit/leave blank locally; deployment workflow supplies both values.
VITE_BUILD_NUMBER=
VITE_COMMIT_SHA=
# Opt in only for local demonstration controls.
VITE_ENABLE_DEMO_USERS=false
# Fictional Pages demo: npm run build:demo uses the dedicated .env.demo file.
# Normal TEST/QA/PROD builds cannot enable demo users with this flag.
