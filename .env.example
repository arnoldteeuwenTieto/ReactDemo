# Public display label; independent of Vite mode and authorization.
VITE_APP_ENV=DEV
# Optional SchemaConfiguration equivalents. Dates are inclusive local calendar days.
# Without dates, only the existing fictional demo has an unconfigured period.
VITE_REPORTING_YEAR=2026
VITE_REPORTING_START=
VITE_REPORTING_END=
VITE_ENABLE_NEW_FEATURE=false
# Optional bypass: explicit fictional demo AND DEV deployment label required.
VITE_ALLOW_DEMO_PERIOD_OVERRIDE=false
# Omit/leave blank locally; deployment workflow supplies both values.
VITE_BUILD_NUMBER=
VITE_COMMIT_SHA=
# Opt in only for local demonstration controls.
VITE_ENABLE_DEMO_USERS=false
# Fictional Pages demo: npm run build:demo uses the dedicated .env.demo file.
# Normal TEST/QA/PROD builds cannot enable demo users with this flag.
